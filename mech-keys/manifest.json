{
  "id": "mech-keys",
  "name": "Mechanical Keyboard",
  "version": "1.0.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "Shreyas",
  "license": "MIT",
  "repository": "https://github.com/shreyas/noctalia-mech-keys",
  "description": "Simulate authentic tactile and clicky mechanical keyboard typing sounds with bar toggle and sound packs.",
  "tags": [
    "Bar",
    "Audio",
    "Keyboard",
    "Fun"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "defaultSettings": {
      "enabledSound": true,
      "soundPack": "boxjade",
      "volume": 0.85,
      "inputDevice": "",
      "showBarIcon": true,
      "enableToasts": true
    }
  }
}
